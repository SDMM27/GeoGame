rules_version = '2';

// Firestore security rules. Copy this file into Firebase console > Firestore > Rules to publish it.
//
// Leaderboards: nobody may delete a score, and an existing score can only be replaced by a better one
// for the same player and mode (see src/utils/saveScore.js). A score with a `uid` belongs to that account
// and carries its username; a score without one (visitor) can't use an account's username.
service cloud.firestore {
  match /databases/{database}/documents {

    function isNumber(value) {
      return value is int || value is float;
    }

    function inRange(value, max) {
      return isNumber(value) && value >= 0 && value <= max;
    }

    // Pseudos are capped at 20 characters in the forms (30 for Country Ranking).
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 30;
    }

    function validLabel(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    // A visitor's name as saveScore.js sends it (normalizeUsername): no space at either end, no double space,
    // and no whitespace other than a single plain space. Otherwise "Alice " would slip past the usernames/ check.
    function visitorName(name) {
      return name.matches('^[^\\s\\p{Z}\\x{FEFF}](?:[^\\s\\p{Z}\\x{FEFF}]| [^\\s\\p{Z}\\x{FEFF}])*$');
    }

    // Account usernames, as validateUsername (account.js) accepts them once normalized:
    // 3 to 20 characters, a letter or digit first, then letters, digits, single spaces, _ . -
    // The size is also capped at 60 because the rules may count bytes rather than characters.
    function validUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 60
        && name.matches('^[\\p{L}\\p{N}](?:[\\p{L}\\p{N}_.-]| [\\p{L}\\p{N}_.-])*$');
    }

    // usernames/{key}: the lowercase username. The rules' lower() only handles ASCII while the app lowercases
    // every letter (toLowerCase), so for a username with other characters the key is only checked to be lowercase
    // and as long as the username.
    function validUsernameKey(key, username) {
      return key == username.lower()
        || (key.lower() == key && key.size() == username.size() && !username.matches('^[\\x00-\\x7F]*$'));
    }

    // Key of the usernames/ document of an account: users/{uid}.usernameKey (written by claimUsername), which is
    // only needed when the rules' ASCII-only lower() can't compute it, otherwise the lowercase username.
    function userKey(user) {
      return user.get('usernameKey', user.username.lower());
    }

    // Leaderboard entry owner: either the signed-in account under its own username,
    // or a visitor (no uid) under a name that no account owns (usernames/{lowercase}, see account.js).
    function validOwner(data) {
      return data.get('uid', null) == null
        ? visitorName(data.name)
          && !exists(/databases/$(database)/documents/usernames/$(data.name.lower()))
        : request.auth != null
          && data.uid == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == data.name;
    }

    // Fields that identify a leaderboard entry must not change when it is replaced.
    function sameFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }

    // Higher score first, then the smaller tiebreaker (time, or total error for Country Ranking).
    // A missing tiebreaker loses against any value.
    function isBetter(newScore, newTime, oldScore, oldTime) {
      return newScore > oldScore
        || (newScore == oldScore && isNumber(newTime) && (!isNumber(oldTime) || newTime < oldTime));
    }

    // ---------- Accounts ----------

    // Claiming a username writes usernames/{lowercase} and users/{uid} in the same transaction (account.js):
    // each rule checks the other document as it will be after the write (getAfter).
    // A username can't be changed, nor can an account hold two: both documents are only deleted together.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && validUsernameKey(name, request.resource.data.username)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.username;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameKey', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && validUsername(request.resource.data.username)
        && validUsernameKey(userKey(request.resource.data), request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(userKey(request.resource.data))).data.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(userKey(request.resource.data))).data.username == request.resource.data.username;
      allow delete: if request.auth != null && request.auth.uid == uid
        && (resource == null || !existsAfter(/databases/$(database)/documents/usernames/$(userKey(resource.data))));

      // Game history (src/utils/gameHistory.js): written once, never edited.
      match /games/{gameId} {
        function inBounds(value, max) {
          return isNumber(value) && value >= -max && value <= max;
        }

        function optionalLabel(data, field) {
          return data.get(field, null) == null || validLabel(data[field]);
        }

        function optionalCount(data, field) {
          return data.get(field, null) == null || inRange(data[field], 100000);
        }

        function validGame(data) {
          return data.keys().hasOnly(['gameType', 'mode', 'score', 'attempts', 'solved', 'found', 'total', 'elapsedTime',
                                      'difficulty', 'continent', 'presetName', 'dailyKey', 'roomCode', 'correct',
                                      'answered', 'bestStreak', 'optimal', 'errors', 'hints', 'totalError', 'playedAt'])
          && data.keys().hasAll(['gameType', 'mode', 'playedAt'])
          && validLabel(data.gameType)
          && data.mode in ['standard', 'ascension', 'daily', 'infinite', 'multi']
          && data.playedAt == request.time
          && (data.get('score', null) == null || inBounds(data.score, 1000000000))
          && (data.get('elapsedTime', null) == null || inRange(data.elapsedTime, 1000000000))
          && (data.get('totalError', null) == null || inBounds(data.totalError, 1000000000))
          && (data.get('solved', null) == null || data.solved is bool)
          && optionalCount(data, 'attempts') && optionalCount(data, 'found') && optionalCount(data, 'total')
          && optionalCount(data, 'correct') && optionalCount(data, 'answered') && optionalCount(data, 'bestStreak')
          && optionalCount(data, 'optimal') && optionalCount(data, 'errors') && optionalCount(data, 'hints')
          && optionalLabel(data, 'difficulty') && optionalLabel(data, 'continent') && optionalLabel(data, 'presetName')
          && optionalLabel(data, 'dailyKey') && optionalLabel(data, 'roomCode');
        }

        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && validGame(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // This account's devices for push notifications (mobile/src/notifications/push.ts), read by api/invite-push.
      match /pushTokens/{token} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'lang', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
          && request.resource.data.platform in ['ios', 'android'];
      }
    }

    match /friendships/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.resource.data.requester == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requester
        && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Room invites between friends (src/utils/invites.js): invites/{room}_{to}
    // { from, fromUsername, to, room, gameId, mode, createdAt }
    match /invites/{id} {
      function friendshipOf(a, b) {
        return a < b ? a + '_' + b : b + '_' + a;
      }

      function validInvite(data) {
        return data.keys().hasOnly(['from', 'fromUsername', 'to', 'room', 'gameId', 'mode', 'createdAt'])
          && data.from == request.auth.uid
          && data.to is string && data.to != data.from
          && data.room is string && data.room.size() == 6
          && id == data.room + '_' + data.to
          && validLabel(data.gameId)
          && data.mode in ['live', 'challenge']
          && data.createdAt == request.time
          && data.fromUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && exists(/databases/$(database)/documents/rooms/$(data.room))
          && get(/databases/$(database)/documents/friendships/$(friendshipOf(data.from, data.to))).data.status == 'accepted';
      }

      allow read: if request.auth != null
        && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      // Opening a room clears the invite to it, whether there is one or not.
      allow delete: if request.auth != null
        && (resource == null || request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create: if request.auth != null && validInvite(request.resource.data);
      allow update: if request.auth != null && validInvite(request.resource.data)
        && request.resource.data.to == resource.data.to;
    }

    // ---------- Leaderboards ----------

    // Solo scores: { name, uid?, score, difficulty, elapsedTime, gameType, continent? }
    match /scores/{scoreId} {
      function validScore(data) {
        return data.keys().hasOnly(['name', 'uid', 'score', 'difficulty', 'elapsedTime', 'gameType', 'continent'])
          && data.keys().hasAll(['name', 'score', 'difficulty', 'gameType'])
          && validName(data.name)
          && validOwner(data)
          && inRange(data.score, 1000000)
          && validLabel(data.difficulty)
          && validLabel(data.gameType)
          && (data.get('elapsedTime', null) == null || inRange(data.elapsedTime, 1000000000))
          && (data.get('continent', null) == null || validLabel(data.continent));
      }

      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow update: if validScore(request.resource.data)
        && sameFields(['name', 'uid', 'difficulty', 'gameType', 'continent'])
        && isBetter(request.resource.data.score, request.resource.data.get('elapsedTime', null),
                    resource.data.score, resource.data.get('elapsedTime', null));
    }

    // Archives, read only: the first leaderboard (scores_v1), and every leaderboard before scores
    // were tied to accounts (*_v2, see scripts/purgeAnonymousScores.mjs).
    match /scores_v1/{document=**} {
      allow read: if true;
    }

    match /scores_v2/{document=**} {
      allow read: if true;
    }

    match /ascension_scores_v2/{document=**} {
      allow read: if true;
    }

    match /daily_scores_v2/{document=**} {
      allow read: if true;
    }

    // Ascension scores: { name, uid?, gameType, presetName, globalTimeMs, globalScore, totalFound, totalSkipped, phaseStats, date }
    match /ascension_scores/{scoreId} {
      function validAscension(data) {
        return data.keys().hasOnly(['name', 'uid', 'gameType', 'presetName', 'globalTimeMs', 'globalScore',
                                    'totalFound', 'totalSkipped', 'phaseStats', 'date'])
          && validName(data.name)
          && validOwner(data)
          && validLabel(data.gameType)
          && validLabel(data.presetName)
          && inRange(data.globalTimeMs, 1000000000)
          && inRange(data.globalScore, 1000000)
          && inRange(data.totalFound, 10000)
          && inRange(data.totalSkipped, 10000)
          && data.phaseStats is list && data.phaseStats.size() <= 20
          && data.date == request.time;
      }

      allow read: if true;
      allow create: if validAscension(request.resource.data);
      allow update: if validAscension(request.resource.data)
        && sameFields(['name', 'uid', 'gameType', 'presetName'])
        && isBetter(request.resource.data.globalScore, request.resource.data.globalTimeMs,
                    resource.data.globalScore, resource.data.get('globalTimeMs', null));
    }

    // Daily challenges (all with name and uid?), two shapes:
    //  - Country Ranking: { name, gameType: 'RANKING', dailyKey, score, totalError, attemptsUsed, playerOrder }
    //  - other games:     { name, gameType, dailyKey, attempts, elapsedTime, guesses, hints? } (fewer attempts wins)
    match /daily_scores/{scoreId} {
      function validRanking(data) {
        return data.gameType == 'RANKING'
          && data.keys().hasOnly(['name', 'uid', 'gameType', 'dailyKey', 'score', 'totalError', 'attemptsUsed', 'playerOrder'])
          && data.keys().hasAll(['name', 'gameType', 'dailyKey', 'score', 'totalError'])
          && inRange(data.score, 1000000)
          && inRange(data.totalError, 1000000)
          && (data.get('attemptsUsed', null) == null || inRange(data.attemptsUsed, 100))
          && (data.get('playerOrder', null) == null || (data.playerOrder is list && data.playerOrder.size() <= 300));
      }

      function validAttempts(data) {
        return data.gameType != 'RANKING'
          && data.keys().hasOnly(['name', 'uid', 'gameType', 'dailyKey', 'attempts', 'elapsedTime', 'guesses', 'hints'])
          && data.keys().hasAll(['name', 'gameType', 'dailyKey', 'attempts'])
          && inRange(data.attempts, 1000)
          && (data.get('elapsedTime', null) == null || inRange(data.elapsedTime, 1000000000))
          && (data.get('hints', null) == null || inRange(data.hints, 1000));
      }

      function validDaily(data) {
        return validName(data.name)
          && validOwner(data)
          && validLabel(data.gameType)
          && validLabel(data.dailyKey)
          && (validRanking(data) || validAttempts(data));
      }

      function effectiveAttempts(data) {
        return data.attempts + data.get('hints', 0);
      }

      function isBetterDaily(next, prev) {
        return next.gameType == 'RANKING'
          ? isBetter(next.score, next.totalError, prev.score, prev.get('totalError', null))
          : (effectiveAttempts(next) < effectiveAttempts(prev)
              || (effectiveAttempts(next) == effectiveAttempts(prev)
                  && isNumber(next.get('elapsedTime', null))
                  && (!isNumber(prev.get('elapsedTime', null)) || next.elapsedTime < prev.elapsedTime)));
      }

      allow read: if true;
      allow create: if validDaily(request.resource.data);
      allow update: if validDaily(request.resource.data)
        && sameFields(['name', 'uid', 'gameType', 'dailyKey'])
        && isBetterDaily(request.resource.data, resource.data);
    }

    // ---------- Multiplayer ----------

    // Players have no account (random id stored on the device): any player of a room has to be able
    // to update it (host transfer, scores, reconfiguration). Rooms can't be deleted.
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;

      match /progress/{playerId} {
        allow read: if true;
        allow write: if true;
      }

      match /gameResults/{docId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Server clock calibration (src/utils/serverTime.js): a throwaway document holding only the server time.
    match /_clockSync/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow delete: if true;
    }
  }
}
