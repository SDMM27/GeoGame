rules_version = '2';

// Firestore security rules, published with `npm run deploy:rules` (tests first, then firebase deploy: see the README).
//
// Leaderboards: nobody may delete a score, and an existing score can only be replaced by a better one
// for the same player and mode (see src/utils/saveScore.js). A score with a `uid` belongs to that account
// and carries its username; a score without one (visitor) can't use an account's username.
service cloud.firestore {
  match /databases/{database}/documents {

    function isNumber(value) {
      return value is int || value is float;
    }

    function inRange(value, max) {
      return isNumber(value) && value >= 0 && value <= max;
    }

    // Last line of defense against the most explicit insults in a name (the real filter is src/utils/profanity.js,
    // on the client). RE2 has no accent or leetspeak normalization, so this only catches plain spellings; it is
    // case-insensitive and kept short on purpose (one match per name, and no word that sits inside a place or a name).
    function cleanName(name) {
      return !name.matches('(?is).*(fuck|nigger|nigga|connard|connasse|salope|putain|encul|pedophile|hitler|bitch|asshole|faggot|whore|хуй|пизд|бляд|мудак|пидор).*');
    }

    // Pseudos are capped at 20 characters in the forms (30 for Country Ranking).
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 30 && cleanName(name);
    }

    function validLabel(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    // A visitor's name as saveScore.js sends it (normalizeUsername): no space at either end, no double space,
    // and no whitespace other than a single plain space. Otherwise "Alice " would slip past the usernames/ check.
    function visitorName(name) {
      return name.matches('^[^\\s\\p{Z}\\x{FEFF}](?:[^\\s\\p{Z}\\x{FEFF}]| [^\\s\\p{Z}\\x{FEFF}])*$');
    }

    // Account usernames, as validateUsername (account.js) accepts them once normalized:
    // 3 to 20 characters, a letter or digit first, then letters, digits, single spaces, _ . -
    // The size is also capped at 60 because the rules may count bytes rather than characters.
    function validUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 60 && cleanName(name)
        && name.matches('^[\\p{L}\\p{N}](?:[\\p{L}\\p{N}_.-]| [\\p{L}\\p{N}_.-])*$');
    }

    // usernames/{key}: the lowercase username. The rules' lower() only handles ASCII while the app lowercases
    // every letter (toLowerCase), so for a username with other characters the key is only checked to be lowercase
    // and as long as the username.
    function validUsernameKey(key, username) {
      return key == username.lower()
        || (key.lower() == key && key.size() == username.size() && !username.matches('^[\\x00-\\x7F]*$'));
    }

    // Key of the usernames/ document of an account: users/{uid}.usernameKey (written by claimUsername), which is
    // only needed when the rules' ASCII-only lower() can't compute it, otherwise the lowercase username.
    function userKey(user) {
      return user.get('usernameKey', user.username.lower());
    }

    // Leaderboard entry owner: either the signed-in account under its own username,
    // or a visitor (no uid) under a name that no account owns (usernames/{lowercase}, see account.js).
    function validOwner(data) {
      return data.get('uid', null) == null
        ? visitorName(data.name)
          && !exists(/databases/$(database)/documents/usernames/$(data.name.lower()))
        : request.auth != null
          && data.uid == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == data.name;
    }

    // Fields that identify a leaderboard entry must not change when it is replaced.
    function sameFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }

    // Higher score first, then the smaller tiebreaker (time, or total error for Country Ranking).
    // A missing tiebreaker loses against any value.
    function isBetter(newScore, newTime, oldScore, oldTime) {
      return newScore > oldScore
        || (newScore == oldScore && isNumber(newTime) && (!isNumber(oldTime) || newTime < oldTime));
    }

    // ---------- Accounts ----------

    // Claiming a username writes usernames/{lowercase} and users/{uid} in the same transaction (account.js):
    // each rule checks the other document as it will be after the write (getAfter).
    // A username can't be changed, nor can an account hold two: both documents are only deleted together.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && validUsernameKey(name, request.resource.data.username)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.username;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameKey', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && validUsername(request.resource.data.username)
        && validUsernameKey(userKey(request.resource.data), request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(userKey(request.resource.data))).data.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(userKey(request.resource.data))).data.username == request.resource.data.username;
      allow delete: if request.auth != null && request.auth.uid == uid
        && (resource == null || !existsAfter(/databases/$(database)/documents/usernames/$(userKey(resource.data))));

      // Game history (src/utils/gameHistory.js): written once, never edited.
      match /games/{gameId} {
        function inBounds(value, max) {
          return isNumber(value) && value >= -max && value <= max;
        }

        function optionalLabel(data, field) {
          return data.get(field, null) == null || validLabel(data[field]);
        }

        function optionalCount(data, field) {
          return data.get(field, null) == null || inRange(data[field], 100000);
        }

        function validGame(data) {
          return data.keys().hasOnly(['gameType', 'mode', 'score', 'attempts', 'solved', 'found', 'total', 'elapsedTime',
                                      'difficulty', 'continent', 'presetName', 'dailyKey', 'roomCode', 'correct',
                                      'answered', 'bestStreak', 'optimal', 'errors', 'hints', 'totalError', 'lives',
                                      'playedAt'])
          && data.keys().hasAll(['gameType', 'mode', 'playedAt'])
          && validLabel(data.gameType)
          && data.mode in ['standard', 'ascension', 'daily', 'infinite', 'multi', 'survival']
          && data.playedAt == request.time
          && (data.get('score', null) == null || inBounds(data.score, 1000000000))
          && (data.get('elapsedTime', null) == null || inRange(data.elapsedTime, 1000000000))
          && (data.get('totalError', null) == null || inBounds(data.totalError, 1000000000))
          && (data.get('solved', null) == null || data.solved is bool)
          && optionalCount(data, 'attempts') && optionalCount(data, 'found') && optionalCount(data, 'total')
          && optionalCount(data, 'correct') && optionalCount(data, 'answered') && optionalCount(data, 'bestStreak')
          && optionalCount(data, 'optimal') && optionalCount(data, 'errors') && optionalCount(data, 'hints')
          && optionalCount(data, 'lives')
          && optionalLabel(data, 'difficulty') && optionalLabel(data, 'continent') && optionalLabel(data, 'presetName')
          && optionalLabel(data, 'dailyKey') && optionalLabel(data, 'roomCode');
        }

        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && validGame(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // This account's devices for push notifications (mobile/src/notifications/push.ts), read by api/invite-push.
      match /pushTokens/{token} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'lang', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
          && request.resource.data.platform in ['ios', 'android'];
      }
    }

    // Friendships (src/utils/friends.js): friendships/{uidA_uidB}, uids sorted, so a pair of accounts has exactly one.
    // { users: [uidA, uidB], usernames: { uid: username }, requester, status, createdAt, acceptedAt }
    // The id and the usernames are checked against the accounts: invites trust a friendship to tell who may invite whom.
    function friendshipOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    match /friendships/{id} {
      function validNewFriendship(data) {
        return data.keys().hasOnly(['users', 'usernames', 'requester', 'status', 'createdAt'])
          && data.keys().hasAll(['users', 'usernames', 'requester', 'status', 'createdAt'])
          && data.users is list && data.users.size() == 2
          && data.users[0] is string && data.users[1] is string && data.users[0] != data.users[1]
          && id == friendshipOf(data.users[0], data.users[1])
          && data.requester == request.auth.uid
          && request.auth.uid in data.users
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.usernames is map
          && data.usernames.keys().hasOnly(data.users)
          && data.usernames.size() == 2
          && data.usernames[data.users[0]] == get(/databases/$(database)/documents/users/$(data.users[0])).data.username
          && data.usernames[data.users[1]] == get(/databases/$(database)/documents/users/$(data.users[1])).data.username;
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && validNewFriendship(request.resource.data);
      // Only the recipient accepts, and nothing else changes.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Room invites between friends (src/utils/invites.js): invites/{room}_{to}
    // { from, fromUsername, to, room, gameId, mode, createdAt, expiresAt? } (expiresAt: see api/cleanup-expired.mjs, missing from older apps)
    match /invites/{id} {
      function isFriendship(friendship, data) {
        return friendship.status == 'accepted' && data.to in friendship.users && data.from in friendship.users;
      }

      function validInvite(data) {
        return data.keys().hasOnly(['from', 'fromUsername', 'to', 'room', 'gameId', 'mode', 'createdAt', 'expiresAt'])
          && data.from == request.auth.uid
          && data.to is string && data.to != data.from
          && data.room is string && data.room.size() == 6
          && id == data.room + '_' + data.to
          && validLabel(data.gameId)
          && data.mode in ['live', 'challenge']
          && data.createdAt == request.time
          && (data.get('expiresAt', null) == null || expiresWithin(data.expiresAt, duration.value(1, 'h'), duration.value(1, 'd')))
          && data.fromUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && exists(/databases/$(database)/documents/rooms/$(data.room))
          && isFriendship(get(/databases/$(database)/documents/friendships/$(friendshipOf(data.from, data.to))).data, data);
      }

      allow read: if request.auth != null
        && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      // Opening a room clears the invite to it, whether there is one or not.
      allow delete: if request.auth != null
        && (resource == null || request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create: if request.auth != null && validInvite(request.resource.data);
      allow update: if request.auth != null && validInvite(request.resource.data)
        && request.resource.data.to == resource.data.to;
    }

    // ---------- Leaderboards ----------

    // Score limits (validScore, validAscension, validDaily) are computed by scripts/scoreCaps.mjs from the game code
    // and the country data. The maps between the scoreCaps markers are rewritten by "node scripts/scoreCaps.mjs --write"
    // and verified by "--check" (and by npm test). Lookups default to -1, so a game or mode that isn't listed is refused.

    // Solo scores: { name, uid?, score, difficulty, elapsedTime, gameType, continent? }
    // The best a game can give is a perfect run of its difficulty (or continent, which then fills `difficulty`) plus a
    // margin, and a game of N countries can't be finished in less than 100 ms per country.
    match /scores/{scoreId} {
      function soloCaps() {
        return {
          // scoreCaps:begin soloCaps
          'PLACEMENT_Facile': 96,
          'PLACEMENT_Moyen': 259,
          'PLACEMENT_Difficile': 809,
          'PLACEMENT_Impossible': 565,
          'PLACEMENT_Hardcore': 1727,
          'PLACEMENT_Europe': 286,
          'PLACEMENT_Asie': 345,
          'PLACEMENT_Afrique': 383,
          'PLACEMENT_Amériques': 407,
          'PLACEMENT_Océanie': 201,
          'FLAGS_Facile': 109,
          'FLAGS_Moyen': 347,
          'FLAGS_Difficile': 655,
          'FLAGS_Impossible': 466,
          'FLAGS_Hardcore': 1576,
          'FLAGS_Europe': 270,
          'FLAGS_Asie': 325,
          'FLAGS_Afrique': 389,
          'FLAGS_Amériques': 383,
          'FLAGS_Océanie': 211,
          'CAPITALS_Facile': 103,
          'CAPITALS_Moyen': 297,
          'CAPITALS_Difficile': 732,
          'CAPITALS_Impossible': 476,
          'CAPITALS_Hardcore': 1606,
          'CAPITALS_Europe': 260,
          'CAPITALS_Asie': 330,
          'CAPITALS_Afrique': 400,
          'CAPITALS_Amériques': 407,
          'CAPITALS_Océanie': 211
          // scoreCaps:end soloCaps
        };
      }

      function soloMinTime() {
        return {
          // scoreCaps:begin soloMinTime
          'PLACEMENT_Facile': 2900,
          'PLACEMENT_Moyen': 4700,
          'PLACEMENT_Difficile': 10500,
          'PLACEMENT_Impossible': 5700,
          'PLACEMENT_Hardcore': 23800,
          'PLACEMENT_Europe': 5100,
          'PLACEMENT_Asie': 5200,
          'PLACEMENT_Afrique': 5600,
          'PLACEMENT_Amériques': 5200,
          'PLACEMENT_Océanie': 2400,
          'FLAGS_Facile': 3300,
          'FLAGS_Moyen': 6300,
          'FLAGS_Difficile': 8500,
          'FLAGS_Impossible': 4700,
          'FLAGS_Hardcore': 22800,
          'FLAGS_Europe': 5000,
          'FLAGS_Asie': 5200,
          'FLAGS_Afrique': 5600,
          'FLAGS_Amériques': 5200,
          'FLAGS_Océanie': 2400,
          'CAPITALS_Facile': 3100,
          'CAPITALS_Moyen': 5400,
          'CAPITALS_Difficile': 9500,
          'CAPITALS_Impossible': 4800,
          'CAPITALS_Hardcore': 22800,
          'CAPITALS_Europe': 5000,
          'CAPITALS_Asie': 5100,
          'CAPITALS_Afrique': 5600,
          'CAPITALS_Amériques': 5200,
          'CAPITALS_Océanie': 2400
          // scoreCaps:end soloMinTime
        };
      }

      function validResult(data) {
        return inRange(data.score, soloCaps().get(data.gameType + '_' + data.difficulty, -1))
          && (data.get('elapsedTime', null) == null
              || (inRange(data.elapsedTime, 1000000000)
                  && data.elapsedTime >= soloMinTime().get(data.gameType + '_' + data.difficulty, 0)));
      }

      function validScore(data) {
        return data.keys().hasOnly(['name', 'uid', 'score', 'difficulty', 'elapsedTime', 'gameType', 'continent'])
          && data.keys().hasAll(['name', 'score', 'difficulty', 'gameType'])
          && validName(data.name)
          && validOwner(data)
          && validLabel(data.difficulty)
          && validLabel(data.gameType)
          && validResult(data)
          && (data.get('continent', null) == null || validLabel(data.continent));
      }

      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow update: if validScore(request.resource.data)
        && sameFields(['name', 'uid', 'difficulty', 'gameType', 'continent'])
        && isBetter(request.resource.data.score, request.resource.data.get('elapsedTime', null),
                    resource.data.score, resource.data.get('elapsedTime', null));
    }

    // Survival scores: { name, uid?, modes, lives, timer, ramp, score, elapsedTime }, the best one per player, set of
    // games, lives, timer (seconds per round, 0 for none) and difficulty ramp (only the presets are ranked:
    // SURVIVAL_RAMPS in src/utils/survivalConfig.js).
    // `modes` names the games of the rounds ('FLAGS+QUIZ', see survivalModesKey in src/utils/survivalConfig.js); `score`
    // counts the rounds cleared, at most SURVIVAL_MAX_ROUNDS (300), and a round can't be cleared in less than 300 ms.
    match /survival_scores/{scoreId} {
      function validSurvival(data) {
        return data.keys().hasOnly(['name', 'uid', 'modes', 'lives', 'timer', 'ramp', 'score', 'elapsedTime'])
          && data.keys().hasAll(['name', 'modes', 'lives', 'timer', 'ramp', 'score', 'elapsedTime'])
          && validName(data.name)
          && validOwner(data)
          && validSurvivalModes(data.modes)
          && data.lives in [1, 3, 5, 10]
          && data.timer in [0, 15, 30, 60]
          && data.ramp in ['express', 'normal', 'gentle', 'hardcore']
          && data.score is int && data.score >= 1 && data.score <= 300
          && inRange(data.elapsedTime, 1000000000) && data.elapsedTime >= data.score * 300;
      }

      allow read: if true;
      allow create: if validSurvival(request.resource.data);
      allow update: if validSurvival(request.resource.data)
        && sameFields(['name', 'uid', 'modes', 'lives', 'timer', 'ramp'])
        && isBetter(request.resource.data.score, request.resource.data.elapsedTime,
                    resource.data.score, resource.data.get('elapsedTime', null));
    }

    // Archives, read only: the first leaderboard (scores_v1), and every leaderboard before scores
    // were tied to accounts (*_v2, see scripts/purgeAnonymousScores.mjs).
    match /scores_v1/{document=**} {
      allow read: if true;
    }

    match /scores_v2/{document=**} {
      allow read: if true;
    }

    match /ascension_scores_v2/{document=**} {
      allow read: if true;
    }

    match /daily_scores_v2/{document=**} {
      allow read: if true;
    }

    // Ascension scores: { name, uid?, gameType, presetName, globalTimeMs, globalScore, totalFound, totalSkipped, phaseStats, date }
    // The preset fixes the countries asked (found + skipped can't exceed them), hence the best score and the
    // shortest time. phaseStats holds one entry per phase, with the phase's own count as its limit.
    match /ascension_scores/{scoreId} {
      function ascensionCaps() {
        return {
          // scoreCaps:begin ascensionCaps
          'Découverte': 69,
          'Progressif': 153,
          'Challenge': 136,
          'Hardcore': 237
          // scoreCaps:end ascensionCaps
        };
      }

      function ascensionTotals() {
        return {
          // scoreCaps:begin ascensionTotals
          'Découverte': 16,
          'Progressif': 31,
          'Challenge': 23,
          'Hardcore': 35
          // scoreCaps:end ascensionTotals
        };
      }

      function ascensionPhases() {
        return {
          // scoreCaps:begin ascensionPhases
          'Découverte': 3,
          'Progressif': 4,
          'Challenge': 4,
          'Hardcore': 4
          // scoreCaps:end ascensionPhases
        };
      }

      function ascensionPhaseCounts() {
        return {
          // scoreCaps:begin ascensionPhaseCounts
          'Découverte_0': 10,
          'Découverte_1': 5,
          'Découverte_2': 1,
          'Progressif_0': 15,
          'Progressif_1': 10,
          'Progressif_2': 5,
          'Progressif_3': 1,
          'Challenge_0': 7,
          'Challenge_1': 7,
          'Challenge_2': 7,
          'Challenge_3': 2,
          'Hardcore_0': 5,
          'Hardcore_1': 10,
          'Hardcore_2': 15,
          'Hardcore_3': 5
          // scoreCaps:end ascensionPhaseCounts
        };
      }

      function ascensionMinTime() {
        return {
          // scoreCaps:begin ascensionMinTime
          'Découverte': 1600,
          'Progressif': 3100,
          'Challenge': 2300,
          'Hardcore': 3500
          // scoreCaps:end ascensionMinTime
        };
      }

      function validPhase(phases, index, count) {
        return phases.size() <= index
          || (phases[index] is map
              && phases[index].keys().hasOnly(['difficulty', 'count', 'found', 'skipped', 'timeMs'])
              && inRange(phases[index].get('count', 0), count)
              && inRange(phases[index].get('found', 0), count)
              && inRange(phases[index].get('skipped', 0), count)
              && inRange(phases[index].get('timeMs', 0), 1000000000));
      }

      function validAscensionResult(data) {
        let preset = data.presetName;
        let counts = ascensionPhaseCounts();
        return data.gameType in ['PLACEMENT', 'FLAGS', 'CAPITALS']
          && inRange(data.globalScore, ascensionCaps().get(preset, -1))
          && inRange(data.totalFound + data.totalSkipped, ascensionTotals().get(preset, -1))
          && data.globalTimeMs >= ascensionMinTime().get(preset, 1000000000)
          && data.phaseStats.size() <= ascensionPhases().get(preset, -1)
          && validPhase(data.phaseStats, 0, counts.get(preset + '_0', -1))
          && validPhase(data.phaseStats, 1, counts.get(preset + '_1', -1))
          && validPhase(data.phaseStats, 2, counts.get(preset + '_2', -1))
          && validPhase(data.phaseStats, 3, counts.get(preset + '_3', -1));
      }

      function validAscension(data) {
        return data.keys().hasOnly(['name', 'uid', 'gameType', 'presetName', 'globalTimeMs', 'globalScore',
                                    'totalFound', 'totalSkipped', 'phaseStats', 'date'])
          && validName(data.name)
          && validOwner(data)
          && validLabel(data.gameType)
          && validLabel(data.presetName)
          && inRange(data.globalTimeMs, 1000000000)
          && inRange(data.totalFound, 10000)
          && inRange(data.totalSkipped, 10000)
          && data.phaseStats is list
          && validAscensionResult(data)
          && data.date == request.time;
      }

      allow read: if true;
      allow create: if validAscension(request.resource.data);
      allow update: if validAscension(request.resource.data)
        && sameFields(['name', 'uid', 'gameType', 'presetName'])
        && isBetter(request.resource.data.globalScore, request.resource.data.globalTimeMs,
                    resource.data.globalScore, resource.data.get('globalTimeMs', null));
    }

    // Daily challenges (all with name and uid?), two shapes:
    //  - Country Ranking: { name, gameType: 'RANKING', dailyKey, score, totalError, attemptsUsed, playerOrder }
    //  - other games:     { name, gameType, dailyKey, attempts, elapsedTime, guesses, hints? } (fewer attempts wins)
    // A daily is saved once solved, so it took at least one attempt. Limits come from the games: quiz tries and hints,
    // the guessable names (Border Guess, Country Clue), the countries of a Voyage Voyage chain (whose elapsedTime holds
    // the wrong guesses), and Country Ranking's 5 countries, 3 tries and 3 points for a perfect first try.
    match /daily_scores/{scoreId} {
      function dailyAttempts() {
        return {
          // scoreCaps:begin dailyAttempts
          'BORDER_GUESS': 510,
          'COUNTRY_CLUE': 510,
          'QUIZ': 5,
          'VOYAGE_VOYAGE': 262
          // scoreCaps:end dailyAttempts
        };
      }

      function dailyHints() {
        return {
          // scoreCaps:begin dailyHints
          'BORDER_GUESS': 0,
          'COUNTRY_CLUE': 0,
          'QUIZ': 3,
          'VOYAGE_VOYAGE': 3
          // scoreCaps:end dailyHints
        };
      }

      function dailyWrong() {
        return {
          // scoreCaps:begin dailyWrong
          'VOYAGE_VOYAGE': 262
          // scoreCaps:end dailyWrong
        };
      }

      function rankingCaps() {
        return {
          // scoreCaps:begin rankingCaps
          'score': 3,
          'totalError': 14,
          'attemptsUsed': 3,
          'players': 5
          // scoreCaps:end rankingCaps
        };
      }

      function validRanking(data) {
        let caps = rankingCaps();
        return data.gameType == 'RANKING'
          && data.keys().hasOnly(['name', 'uid', 'gameType', 'dailyKey', 'score', 'totalError', 'attemptsUsed', 'playerOrder'])
          && data.keys().hasAll(['name', 'gameType', 'dailyKey', 'score', 'totalError'])
          && inRange(data.score, caps['score'])
          && inRange(data.totalError, caps['totalError'])
          && (data.score == 0 || data.totalError == 0)
          && (data.get('attemptsUsed', null) == null
              || (inRange(data.attemptsUsed, caps['attemptsUsed']) && data.attemptsUsed >= 1))
          && (data.get('playerOrder', null) == null
              || (data.playerOrder is list && data.playerOrder.size() <= caps['players']));
      }

      function validAttempts(data) {
        return data.gameType != 'RANKING'
          && data.keys().hasOnly(['name', 'uid', 'gameType', 'dailyKey', 'attempts', 'elapsedTime', 'guesses', 'hints'])
          && data.keys().hasAll(['name', 'gameType', 'dailyKey', 'attempts'])
          && data.attempts >= 1
          && inRange(data.attempts, dailyAttempts().get(data.gameType, -1))
          && (data.get('elapsedTime', null) == null
              || inRange(data.elapsedTime, dailyWrong().get(data.gameType, 1000000000)))
          && (data.get('hints', null) == null || inRange(data.hints, dailyHints().get(data.gameType, -1)))
          && data.get('guesses', []) is list && data.get('guesses', []).size() <= 600;
      }

      function validDaily(data) {
        return validName(data.name)
          && validOwner(data)
          && validLabel(data.gameType)
          && validLabel(data.dailyKey)
          && (validRanking(data) || validAttempts(data));
      }

      function effectiveAttempts(data) {
        return data.attempts + data.get('hints', 0);
      }

      function isBetterDaily(next, prev) {
        return next.gameType == 'RANKING'
          ? isBetter(next.score, next.totalError, prev.score, prev.get('totalError', null))
          : (effectiveAttempts(next) < effectiveAttempts(prev)
              || (effectiveAttempts(next) == effectiveAttempts(prev)
                  && isNumber(next.get('elapsedTime', null))
                  && (!isNumber(prev.get('elapsedTime', null)) || next.elapsedTime < prev.elapsedTime)));
      }

      allow read: if true;
      allow create: if validDaily(request.resource.data);
      allow update: if validDaily(request.resource.data)
        && sameFields(['name', 'uid', 'gameType', 'dailyKey'])
        && isBetterDaily(request.resource.data, resource.data);
    }

    // ---------- Multiplayer ----------

    // Rooms (src/utils/multiplayerRoom.js). Players have no account: a player is a random id kept on the device
    // (players.{id}) plus a random secret that the device keeps to itself, stored in rooms/{room}/keys/{id}.
    // That document can never be read, only compared: every write a player makes goes in a batch that also
    // sets keys/{id} = { key, at: serverTimestamp }. The key document only accepts that write when `key` matches the
    // stored secret (or when it is created, as the player joins), and the other rules check getAfter(keys/{id}).at
    // == request.time: proof, within this very request, that the writer knows the secret of the player they act as.
    // Nobody else can write as that player; only the host (hostId) changes the games, the status and the launch.
    // The room's `by` field says which player writes.
    //
    // Rooms from before these rules (source 'app', written by app 1.0.1 and the old website) carry no secrets:
    // they stay open to everyone, with size limits only, until the cutoff below. They can't be created after it.
    // After 2026-12-01, once no 'app' room is left in the database and no app 1.0.1 is in use, every `legacyOpen()` branch,
    // validLegacy* and the 'app' handling in the clients and tests can go (grep legacyOpen / isRoomFormat).
    function legacyOpen() {
      return request.time < timestamp.date(2026, 12, 1);
    }

    function validPlayerId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[A-Za-z0-9_-]+$');
    }

    // expiresAt, for the daily cleanup (api/cleanup-expired.mjs): later than `min` and at most `max` from now. Clients use the lifetime
    // they want from their own clock, so the bounds leave room for clocks that are off by a day or two.
    function expiresWithin(value, min, max) {
      return value is timestamp && value > request.time + min && value <= request.time + max;
    }

    // Short strings only: a missing or null field is fine.
    function shortOrNull(value) {
      return value == null || (value is string && value.size() <= 60);
    }

    // Games of a survival run, in setup order: 'PLACEMENT+FLAGS+QUIZ' (survivalModesKey in src/utils/survivalConfig.js).
    function validSurvivalModes(modes) {
      return modes is string && modes.size() <= 80
        && modes.matches('^(PLACEMENT|FLAGS|CAPITALS|BORDER_GUESS|QUIZ)([+](PLACEMENT|FLAGS|CAPITALS|BORDER_GUESS|QUIZ))*$');
    }

    // Survival difficulty ramp: the rounds at each difficulty before Impossible (SURVIVAL_RAMP_MAX at most).
    function validSurvivalRamp(ramp) {
      return ramp is map
        && ramp.keys().hasOnly(['Facile', 'Moyen', 'Difficile'])
        && inRange(ramp.get('Facile', 0), 50) && inRange(ramp.get('Moyen', 0), 50) && inRange(ramp.get('Difficile', 0), 50);
    }

    // Ascension phases: the number of countries per difficulty.
    function validPhases(phases) {
      return phases is map
        && phases.keys().hasOnly(['Facile', 'Moyen', 'Difficile', 'Impossible'])
        && inRange(phases.get('Facile', 0), 1000) && inRange(phases.get('Moyen', 0), 1000)
        && inRange(phases.get('Difficile', 0), 1000) && inRange(phases.get('Impossible', 0), 1000);
    }

    function validRoomGame(game) {
      return game is map
        && game.keys().hasOnly(['id', 'type', 'difficulty', 'continent', 'phases', 'presetName', 'count',
                                'quizDifficulty', 'answerMode', 'modes', 'lives', 'timer', 'ramp'])
        && game.id is string && game.id.size() > 0 && game.id.size() <= 60
        && game.type is string && game.type.size() > 0 && game.type.size() <= 60
        && shortOrNull(game.get('difficulty', null)) && shortOrNull(game.get('continent', null))
        && shortOrNull(game.get('presetName', null)) && shortOrNull(game.get('quizDifficulty', null))
        && (game.get('answerMode', null) == null || game.answerMode in ['choices', 'free'])
        && (game.get('count', null) == null || (isNumber(game.count) && game.count >= 1 && game.count <= 300))
        && (game.get('phases', null) == null || validPhases(game.phases))
        && (game.get('modes', null) == null || validSurvivalModes(game.modes))
        && (game.get('lives', null) == null || game.lives in [1, 3, 5, 10])
        && (game.get('timer', null) == null || game.timer in [0, 15, 30, 60])
        && (game.get('ramp', null) == null || validSurvivalRamp(game.ramp));
    }

    // players.{id}: { pseudo, uid?, seenAt? }; seenAt is the heartbeat, always the server time.
    function validRoomPlayer(player) {
      return player is map
        && player.keys().hasOnly(['pseudo', 'uid', 'seenAt'])
        && player.keys().hasAll(['pseudo'])
        && validName(player.pseudo)
        && (player.get('uid', null) == null || (player.uid is string && player.uid.size() <= 128))
        && (player.get('seenAt', null) == null || player.seenAt == request.time);
    }

    function validStart(startAt) {
      return startAt is timestamp
        && startAt > request.time - duration.value(1, 'd') && startAt < request.time + duration.value(1, 'd');
    }

    match /rooms/{roomId} {
      function proved(playerId) {
        let key = /databases/$(database)/documents/rooms/$(roomId)/keys/$(playerId);
        return getAfter(key).data.at == request.time;
      }

      // The host is gone: no heartbeat for 100 s (clients wait 120 s), or no entry at all.
      function hostGone(room) {
        return !(room.hostId in room.players)
          || (room.players[room.hostId].get('seenAt', null) != null
              && request.time.toMillis() - room.players[room.hostId].seenAt.toMillis() > 100000);
      }

      function validNewRoom(data) {
        return data.keys().hasOnly(['source', 'createdOn', 'hostId', 'mode', 'status', 'games', 'gameIndex', 'game',
                                    'seed', 'startAt', 'players', 'createdAt', 'expiresAt', 'by'])
          && data.keys().hasAll(['source', 'createdOn', 'hostId', 'mode', 'status', 'games', 'gameIndex', 'game',
                                 'seed', 'startAt', 'players', 'createdAt', 'expiresAt', 'by'])
          && data.source == 'app2'
          && data.createdOn in ['web', 'app']
          && validPlayerId(data.hostId)
          && data.mode in ['live', 'challenge']
          && data.status == (data.mode == 'live' ? 'lobby' : 'playing')
          && data.games is list && data.games.size() == 1 && validRoomGame(data.games[0])
          && data.gameIndex == 0
          && data.game == data.games[0]
          && data.seed is int && data.seed >= 0 && data.seed <= 2147483647
          && data.startAt == null
          && data.players is map && data.players.size() == 1 && data.players.keys().hasOnly([data.hostId])
          && validRoomPlayer(data.players[data.hostId])
          && data.createdAt == request.time
          && expiresWithin(data.expiresAt, duration.value(1, 'd'), duration.value(10, 'd'))
          && data.by == data.hostId
          && proved(data.hostId);
      }

      // Anyone in the room: joins, heartbeats, renames: only their own entry.
      function isPlayerUpdate(data, room, changed) {
        return changed.hasOnly(['by', 'players'])
          && data.players.size() <= 50
          && data.players.diff(room.players).affectedKeys().hasOnly([data.by])
          && validRoomPlayer(data.players[data.by]);
      }

      // The host only: launches the game, moves on to the next one, adds a game at the end.
      function isHostUpdate(data, room, changed) {
        return data.by == room.hostId
          && (
            // launch
            (changed.hasOnly(['by', 'status', 'startAt'])
              && room.status == 'lobby' && data.status == 'playing' && validStart(data.startAt))
            // next game (live)
            || (room.mode == 'live' && changed.hasOnly(['by', 'gameIndex', 'game', 'status', 'startAt'])
              && data.gameIndex == room.gameIndex + 1 && data.gameIndex < data.games.size()
              && data.game == data.games[data.gameIndex] && data.status == 'playing' && validStart(data.startAt))
            // add a game
            || (changed.hasOnly(['by', 'games'])
              && data.games.size() == room.games.size() + 1 && data.games.size() <= 20
              && data.games[0:room.games.size()] == room.games
              && validRoomGame(data.games[room.games.size()]))
          );
      }

      // A player of a lobby whose host went quiet takes the room over.
      function isTakeOver(data, room, changed) {
        return changed.hasOnly(['by', 'hostId'])
          && data.hostId == data.by
          && room.status == 'lobby'
          && data.by in room.players
          && hostGone(room);
      }

      function validRoomUpdate(data, room) {
        let changed = data.diff(room).affectedKeys();
        return changed.hasOnly(['by', 'players', 'hostId', 'games', 'gameIndex', 'game', 'status', 'startAt'])
          && validPlayerId(data.by) && proved(data.by)
          && (isPlayerUpdate(data, room, changed) || isHostUpdate(data, room, changed)
              || isTakeOver(data, room, changed));
      }

      // Rooms from before the secrets (see legacyOpen): the old fields only, within bounds. The rules have no loops
      // and run out of expressions past a few games, so a game is only checked when it is added one at a time (or
      // as the room's `game`); a room an old website created with several games keeps the others unchecked.
      function validLegacyFields(data) {
        return data.keys().hasOnly(['source', 'createdOn', 'hostId', 'mode', 'status', 'games', 'gameIndex', 'game',
                                    'seed', 'startAt', 'players', 'createdAt', 'by'])
          && validPlayerId(data.hostId)
          && data.mode in ['live', 'challenge']
          && data.status in ['lobby', 'playing']
          && validRoomGame(data.game)
          && (data.get('games', null) == null || (data.games is list && data.games.size() >= 1 && data.games.size() <= 20))
          && (data.get('gameIndex', null) == null || (data.gameIndex is int && data.gameIndex >= 0 && data.gameIndex < 20))
          && (data.startAt == null || validStart(data.startAt))
          && data.players is map && data.players.size() >= 1 && data.players.size() <= 50;
      }

      function validLegacyCreate(data) {
        return validLegacyFields(data)
          && data.keys().hasAll(['source', 'hostId', 'mode', 'status', 'game', 'seed', 'startAt', 'players', 'createdAt'])
          && data.source == 'app'
          && data.get('createdOn', 'web') in ['web', 'app']
          && data.seed is int && data.seed >= 0 && data.seed <= 2147483647
          && data.players.size() == 1
          && data.get('games', [data.game])[0] == data.game
          && data.createdAt == request.time;
      }

      function validLegacyUpdate(data, room) {
        return validLegacyFields(data)
          && data.diff(room).affectedKeys().hasOnly(['by', 'players', 'hostId', 'games', 'gameIndex', 'game', 'status', 'startAt'])
          && data.players.diff(room.players).affectedKeys().size() <= 1
          && (!('games' in data.diff(room).affectedKeys())
              || (data.games.size() == room.games.size() + 1
                  && data.games[0:room.games.size()] == room.games
                  && validRoomGame(data.games[room.games.size()])));
      }

      // The room is readable by its code, but the rooms can't be listed.
      allow get: if true;
      allow create: if roomId.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$')
        && (validNewRoom(request.resource.data) || (legacyOpen() && validLegacyCreate(request.resource.data)));
      allow update: if resource.data.get('source', null) == 'app2'
        ? validRoomUpdate(request.resource.data, resource.data)
        : legacyOpen() && validLegacyUpdate(request.resource.data, resource.data);

      // The secrets: written as a player joins, then only ever compared (see above).
      match /keys/{playerId} {
        allow create: if validPlayerId(playerId)
          && request.resource.data.keys().hasOnly(['key', 'at'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 16 && request.resource.data.key.size() <= 64
          && request.resource.data.at == request.time
          && playerId in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.players
          && (getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.get('source', null) != 'app2'
              || !exists(/databases/$(database)/documents/rooms/$(roomId))
              || !(playerId in get(/databases/$(database)/documents/rooms/$(roomId)).data.players));
        allow update: if request.resource.data.keys().hasOnly(['key', 'at'])
          && request.resource.data.key == resource.data.key
          && request.resource.data.at == request.time;
      }

      // progress/{playerId}: { gameIndex, found, total, finished, lives?, round?, roundAt?, roundDone?, lastSeen, expiresAt }
      // Survival: the lives left; in a live room, the round being played, when it started (server ms) and whether
      // the player is done with it (src/utils/survivalSync.js).
      match /progress/{playerId} {
        function validProgress(data) {
          return data.keys().hasOnly(['gameIndex', 'found', 'total', 'finished', 'lives', 'round', 'roundAt', 'roundDone',
                                      'lastSeen', 'expiresAt'])
            && data.keys().hasAll(['gameIndex', 'found', 'total', 'finished'])
            && inRange(data.gameIndex, 19) && inRange(data.found, 1000) && inRange(data.total, 1000)
            && data.finished is bool
            && (data.get('lives', null) == null || inRange(data.lives, 10))
            && (data.get('round', null) == null || inRange(data.round, 300))
            && (data.get('roundAt', null) == null || inRange(data.roundAt, 10000000000000))
            && (data.get('roundDone', null) == null || data.roundDone is bool)
            && (data.get('lastSeen', null) == null || data.lastSeen == request.time);
        }

        function allowedProgress(data) {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return validProgress(data)
            && (room.get('source', null) == 'app2'
                ? validPlayerId(playerId) && proved(playerId)
                    && expiresWithin(data.expiresAt, duration.value(1, 'h'), duration.value(10, 'd'))
                : legacyOpen() && validPlayerId(playerId)
                    && (data.get('expiresAt', null) == null
                        || expiresWithin(data.expiresAt, duration.value(1, 'h'), duration.value(10, 'd'))));
        }

        allow read: if true;
        allow create, update: if allowedProgress(request.resource.data);
      }

      // gameResults/{gameIndex}_{playerId}
      match /gameResults/{docId} {
        function validResult(data) {
          return data.keys().hasOnly(['playerId', 'pseudo', 'gameIndex', 'weightedScore', 'countriesSolved',
                                      'attempts', 'elapsedTime', 'total', 'finishedAt', 'expiresAt'])
            && data.keys().hasAll(['playerId', 'pseudo', 'gameIndex', 'weightedScore', 'countriesSolved',
                                   'attempts', 'elapsedTime', 'total', 'finishedAt'])
            && validPlayerId(data.playerId) && validName(data.pseudo)
            && inRange(data.gameIndex, 19)
            && docId == string(data.gameIndex) + '_' + data.playerId
            && inRange(data.weightedScore, 1000000000) && inRange(data.countriesSolved, 1000)
            && inRange(data.attempts, 100000) && inRange(data.elapsedTime, 1000000000)
            && inRange(data.total, 1000)
            && data.finishedAt == request.time;
        }

        function allowedResult(data) {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return validResult(data)
            && (room.get('source', null) == 'app2'
                ? proved(data.playerId)
                    && expiresWithin(data.expiresAt, duration.value(1, 'h'), duration.value(10, 'd'))
                : legacyOpen()
                    && (data.get('expiresAt', null) == null
                        || expiresWithin(data.expiresAt, duration.value(1, 'h'), duration.value(10, 'd'))));
        }

        allow read: if true;
        allow create, update: if allowedResult(request.resource.data);
      }
    }

    // Reports of a leaderboard entry (src/utils/reports.js): reports/{reporter}_{collection}_{scoreId}. Create only:
    // nothing is read, edited or deleted from the apps; the admin reads them in the Firebase console or with
    // scripts/reports.mjs. One report per reporter and entry (the id; a second one would be an update, refused).
    // A signed-in reporter is their uid; a visitor is 'v-' + the id kept on their device (a visitor can make up as
    // many as they want, so this stops accidents and double taps, not a determined spammer). The entry must exist.
    match /reports/{reportId} {
      function validReport(data) {
        return data.keys().hasOnly(['reporter', 'targetCollection', 'targetId', 'targetName', 'reason', 'note', 'createdAt'])
          && data.keys().hasAll(['reporter', 'targetCollection', 'targetId', 'reason', 'createdAt'])
          && data.reporter is string
          && (request.auth != null
              ? data.reporter == request.auth.uid
              : data.reporter.matches('^v-[A-Za-z0-9-]{8,64}$'))
          && data.targetCollection in ['scores', 'ascension_scores', 'daily_scores', 'survival_scores']
          && data.targetId is string && data.targetId.matches('^[A-Za-z0-9]{1,64}$')
          && reportId == data.reporter + '_' + data.targetCollection + '_' + data.targetId
          && (data.get('targetName', null) == null || (data.targetName is string && data.targetName.size() <= 60))
          && data.reason in ['offensive_name', 'cheating', 'other']
          && (data.get('note', null) == null || (data.note is string && data.note.size() <= 200))
          && data.createdAt == request.time
          && exists(/databases/$(database)/documents/$(data.targetCollection)/$(data.targetId));
      }

      allow create: if validReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // Server clock calibration (src/utils/serverTime.js): a throwaway document holding only the server time.
    // Clients never delete it: the daily cleanup (api/cleanup-expired.mjs) does, from `t`, which the server sets.
    // So expiresAt stays optional, even after the cutoff: the client can only compute it from its own clock, and
    // requiring it would reject the very devices whose clock is wrong (e.g. set to tomorrow for the daily challenge).
    match /_clockSync/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['t', 'expiresAt'])
        && request.resource.data.t == request.time
        && (request.resource.data.get('expiresAt', null) == null
            || expiresWithin(request.resource.data.expiresAt, duration.value(1, 'm'), duration.value(1, 'h')));
    }
  }
}
